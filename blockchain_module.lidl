interface LogosBlockchainModule {
    // Lifecycle
    fn start(config_path: string, deployment: string);
    fn stop();

    // Config management
    fn generate_user_config(json_args: string) -> string;
    fn update_user_config(user_config_path: string, keystore_path: string);
    fn migrate_user_config(output_path: string, keystore_path: string);
    fn migrate_user_config_0_1_2(new_config_path: string, old_config_path: string, keystore_path: string);
    fn participate(config_path: string, keystore_path: string, output_dir: string, external_address: string);

    // Keystore
    fn generate_key(user_config_path: string, keystore_path: string, key_type: string, key_title: string) -> string;
    fn add_key(user_config_path: string, keystore_path: string, key_type: string, key_hex: string, key_title: string);
    fn remove_key(user_config_path: string, keystore_path: string, key_title: string);

    // Identity
    fn get_peer_id(config_path: string) -> string;

    // Wallet
    fn wallet_get_balance(address_hex: string) -> string;
    fn wallet_transfer_funds(change_public_key: string, sender_addresses: array<string>, recipient_address: string, amount: string, optional_tip_hex: string) -> string;
    fn wallet_get_known_addresses() -> array<string>;
    fn wallet_get_notes(wallet_address_hex: string, optional_tip_hex: string) -> string;
    fn leader_claim() -> string;
    fn wallet_get_claimable_vouchers() -> string;
    fn wallet_fund_tx(request_json: string) -> string;

    // Transactions
    fn submit_signed_transaction(signed_tx_json: string) -> string;

    // Channel
    fn channel_deposit(channel_id_hex: string, funding_public_key_hex: string, amount: string, metadata_hex: string, optional_tip_hex: string) -> string;
    fn channel_deposit_with_notes(channel_id_hex: string, input_note_id_hexes: array<string>, metadata_hex: string, change_public_key_hex: string, funding_public_key_hexes: array<string>, max_tx_fee: string, optional_tip_hex: string) -> string;
    fn get_channel_state(channel_id_hex: string) -> string;

    // Blend
    fn blend_join_as_core_node(locator: string, locked_note_id_hex: string) -> string;

    // Explorer
    fn get_block(header_id_hex: string) -> string;
    fn get_blocks(from_slot: u64, to_slot: u64) -> string;
    fn get_transaction(tx_hash_hex: string) -> string;

    // Cryptarchia
    fn get_cryptarchia_info() -> string;
    fn get_block_events(header_id_hex: string) -> string;

    // Time
    fn get_time_info() -> string;

    // Events
    event newBlock(blockJson: string);
    event processedBlock(eventJson: string);
    event libBlock(blockInfoJson: string);
}
